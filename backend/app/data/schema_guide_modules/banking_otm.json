    {
      "name": "otm_bank",
      "description": "One-time mandate (OTM) via bank registration.",
      "sql_pattern": "sphmf.multiple_bank mb ON mb.folio_no = dim.folio_number JOIN public.payout_mechanism pm ON mb.paymech = pm.pay_mech WHERE pm.otm_flag IS TRUE AND mb.om_umrn IS NOT NULL"
