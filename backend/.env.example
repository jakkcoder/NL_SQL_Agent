# Runtime
APP_ENV=local
LOG_LEVEL=INFO
SERVICE_NAME=nl-sql-agent
# Serve ADK Web UI at http://127.0.0.1:8000/ when using uvicorn (default true for local/dev)
ADK_WEB_UI=true

# Database - development (used when APP_ENV=local|dev|development)
# Default flow: local Docker Postgres (clone target). Start: ./scripts/local_postgres_up.sh
USE_LOCAL_DOCKER_POSTGRES=true
LOCAL_DATABASE_URL=postgresql://localdev:localdev@localhost:5433/investor_db_local
# Remote VPN dev (for pg_dump clone only — set in temp/clone.env as SOURCE_DATABASE_URL, or below):
# USE_LOCAL_DOCKER_POSTGRES=false
# DEV_DATABASE_URL=postgresql://USER:ENCODED_PASSWORD@HOST:PORT/DBNAME?sslmode=require
DEV_DATABASE_URL=postgresql://localdev:localdev@localhost:5433/investor_db_local
DEV_DB_STATEMENT_TIMEOUT_MS=15000
DEV_DB_POOL_MIN_SIZE=1
DEV_DB_POOL_MAX_SIZE=4
DEV_DB_CONNECT_TIMEOUT_SECONDS=5
DEV_DB_POOL_TIMEOUT_SECONDS=10

# Database - production (used when APP_ENV=production|prod)
PROD_DATABASE_URL=postgresql://readonly_user:readonly_password@prod-db-host:5432/investor_db
PROD_DB_STATEMENT_TIMEOUT_MS=15000
PROD_DB_POOL_MIN_SIZE=2
PROD_DB_POOL_MAX_SIZE=10

# Search defaults
DEFAULT_DEV_ARN=ARN-0411
DEFAULT_PAGE_LIMIT=25

# On-demand filter catalog refresh (PostgreSQL; uses DEV_DATABASE_URL / local Docker):
# PYTHONPATH=. python scripts/refresh_filter_catalog.py

# Optional override for the catalog SQL generator (LiteLLM model id, e.g. bedrock/...).
# DYNAMIC_SQL_LLM_MODEL=

# Menu param LLM — maps NL to filter_dp_investor_menu args (``investor_menu_query`` / LiteLLM).
# Defaults to BEDROCK_QUERY_GENERATOR_MODEL_ID when LLM_PROVIDER=bedrock.
# QUERY_GENERATOR_LLM_MODEL=
# QUERY_GENERATOR_MAX_OUTPUT_TOKENS=4096
# QUERY_GENERATOR_CATALOG_MAX_CHARS=200000
# QUERY_GENERATOR_SCHEMA_CONTRACT_MAX_CHARS=120000
# QUERY_GENERATOR_GUIDE_ONLY=true
# QUERY_GENERATOR_MODULAR_GUIDE=true
# QUERY_GENERATOR_GUIDE_MAX_MODULES=5
# QUERY_GENERATOR_MODULAR_GUIDE_MAX_CHARS=48000
# QUERY_GENERATOR_MODULE_ROUTER_LLM=true
# QUERY_GENERATOR_MODULE_ROUTER_KEYWORD_FALLBACK=true
# BEDROCK_MODULE_ROUTER_MODEL_ID=anthropic.claude-3-haiku-20240307-v1:0
# MODULE_ROUTER_REQUEST_TIMEOUT_SECONDS=30
# MODULE_ROUTER_MAX_OUTPUT_TOKENS=512
# CATALOG_SQL_EXECUTE_ENABLED=true
# CATALOG_SQL_MAX_DISPLAY_ROWS=50
# CATALOG_SQL_MAX_RETRIES_ON_EXECUTE_ERROR=1
# CATALOG_SQL_VALIDATION_REPAIR_ENABLED=true
# CATALOG_SQL_VALIDATION_REPAIR_TIMEOUT_SECONDS=45
# CATALOG_SQL_VALIDATION_REPAIR_MAX_OUTPUT_TOKENS=2048
# BEDROCK_CATALOG_SQL_VALIDATION_REPAIR_MODEL_ID=anthropic.claude-3-haiku-20240307-v1:0
# CATALOG_SQL_EXECUTE_GRACE_SECONDS=8
# CATALOG_SQL_SKIP_REPAIR_ON_TIMEOUT=true
# QUERY_GENERATOR_REQUEST_TIMEOUT_SECONDS=120

# LLM - AWS Bedrock (via ADK LiteLLM)
LLM_PROVIDER=bedrock
# Root ADK agent: small/fast model (routing, greeting, tool calls).
BEDROCK_MODEL_ID=anthropic.claude-3-haiku-20240307-v1:0
# Optional explicit root override (else BEDROCK_MODEL_ID is used):
# BEDROCK_ROOT_MODEL_ID=anthropic.claude-3-haiku-20240307-v1:0
# Catalog SQL generator: large-context model (full filter_catalog_json in one prompt).
BEDROCK_QUERY_GENERATOR_MODEL_ID=anthropic.claude-3-sonnet-20240229-v1:0
# Root alternatives (enable in Bedrock → Model access for your AWS_REGION):
# BEDROCK_MODEL_ID=amazon.nova-lite-v1:0
# BEDROCK_MODEL_ID=amazon.nova-micro-v1:0
# BEDROCK_MODEL_ID=anthropic.claude-3-5-haiku-20241022-v1:0
# Query-generator alternatives (large context):
# BEDROCK_QUERY_GENERATOR_MODEL_ID=amazon.nova-pro-v1:0
# BEDROCK_QUERY_GENERATOR_MODEL_ID=anthropic.claude-3-sonnet-20240229-v1:0
LLM_REQUEST_TIMEOUT_SECONDS=60
LLM_TEMPERATURE=0
LLM_MAX_OUTPUT_TOKENS=1024

# Optional Google Gemini fallback (not used when LLM_PROVIDER=bedrock)
GOOGLE_API_KEY=
GOOGLE_ADK_MODEL=gemini-2.0-flash
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=us-central1
GOOGLE_GENAI_USE_VERTEXAI=false

# AWS (Bedrock) — required for chat; use real values or AWS_PROFILE (not both stale keys + profile)
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Required when using SSO / assumed-role temp creds; leave empty for long-lived IAM user keys only
AWS_SESSION_TOKEN=
# Preferred locally: aws configure / aws sso login, then set profile and leave access keys empty
AWS_PROFILE=
AWS_ROLE_ARN=
AWS_SECRETS_MANAGER_PREFIX=nl-sql-agent

# Security
ALLOWED_ORIGINS=http://localhost:8000,http://localhost:3000,http://127.0.0.1:5500,null
