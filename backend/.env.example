# Runtime
APP_ENV=local
LOG_LEVEL=INFO
SERVICE_NAME=nl-sql-agent
# Serve ADK Web UI at http://127.0.0.1:8000/ when using uvicorn (default true for local/dev)
ADK_WEB_UI=true

# Database - development (used when APP_ENV=local|dev|development)
# Local placeholder:
DEV_DATABASE_URL=postgresql://readonly_user:readonly_password@localhost:5432/investor_db_dev
# Corporate / VPN dev DB (replace USER, PASSWORD, HOST, PORT, DBNAME from your team; never commit real values):
# URL-encode special characters in the password (e.g. @ → %40, # → %23).
# DEV_DATABASE_URL=postgresql://USER:ENCODED_PASSWORD@HOST:PORT/DBNAME
# Optional if the server requires TLS: append ?sslmode=require
DEV_DB_STATEMENT_TIMEOUT_MS=15000
DEV_DB_POOL_MIN_SIZE=1
DEV_DB_POOL_MAX_SIZE=4
DEV_DB_CONNECT_TIMEOUT_SECONDS=5
DEV_DB_POOL_TIMEOUT_SECONDS=10

# Database - production (used when APP_ENV=production|prod)
PROD_DATABASE_URL=postgresql://readonly_user:readonly_password@prod-db-host:5432/investor_db
PROD_DB_STATEMENT_TIMEOUT_MS=15000
PROD_DB_POOL_MIN_SIZE=2
PROD_DB_POOL_MAX_SIZE=10

# Search defaults
DEFAULT_DEV_ARN=ARN-0411
DEFAULT_PAGE_LIMIT=25
MAX_INTERSECTION_ROWS=5000

# Optional: LLM-generated read-only SQL (schema contract + ReAct, max 3 attempts per question).
# When true, ``run_dynamic_investor_sql_tool`` is registered on the root agent.
DYNAMIC_INVESTOR_SQL_ENABLED=false
# Optional override for the SQL engine only (LiteLLM model id, e.g. anthropic.claude-3-5-haiku-20241022-v1:0 or bedrock/...).
# DYNAMIC_SQL_LLM_MODEL=

# LLM - AWS Bedrock (via ADK LiteLLM)
LLM_PROVIDER=bedrock
BEDROCK_MODEL_ID=anthropic.claude-3-haiku-20240307-v1:0
# Alternatives (enable in Bedrock → Model access for your AWS_REGION):
# BEDROCK_MODEL_ID=amazon.nova-lite-v1:0
# BEDROCK_MODEL_ID=amazon.nova-micro-v1:0
# BEDROCK_MODEL_ID=anthropic.claude-3-5-haiku-20241022-v1:0
LLM_REQUEST_TIMEOUT_SECONDS=60
LLM_TEMPERATURE=0
LLM_MAX_OUTPUT_TOKENS=1024

# Optional Google Gemini fallback (not used when LLM_PROVIDER=bedrock)
GOOGLE_API_KEY=
GOOGLE_ADK_MODEL=gemini-2.0-flash
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=us-central1
GOOGLE_GENAI_USE_VERTEXAI=false

# AWS (Bedrock) — required for chat; use real values or AWS_PROFILE (not both stale keys + profile)
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Required when using SSO / assumed-role temp creds; leave empty for long-lived IAM user keys only
AWS_SESSION_TOKEN=
# Preferred locally: aws configure / aws sso login, then set profile and leave access keys empty
AWS_PROFILE=
AWS_ROLE_ARN=
AWS_SECRETS_MANAGER_PREFIX=nl-sql-agent

# Security
ALLOWED_ORIGINS=http://localhost:8000,http://localhost:3000,http://127.0.0.1:5500,null
